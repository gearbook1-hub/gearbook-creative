# Copy to .env.local and fill in. Never commit .env.local.
# Everything works without these: the dashboard falls back to the sample data in data/.

# Claude API: lets `npm run scout` read transcripts and pitch ideas for real.
ANTHROPIC_API_KEY=
# Optional model override for the scout (defaults to claude-opus-5-5).
SCOUT_MODEL=

# GearBook Supabase, READ-ONLY: real click and sale numbers for the data pieces
# (click_events, sale_events). Use the anon key with RLS, never the service role key.
GEARBOOK_SUPABASE_URL=
GEARBOOK_SUPABASE_ANON_KEY=

# Metricool: the @gear.book reel list and per-post stats for the Video Inbox.
METRICOOL_USER_TOKEN=
METRICOOL_USER_ID=
METRICOOL_BLOG_ID=

# Where raw reels land before transcription (default: inbox/videos).
INBOX_VIDEO_DIR=
